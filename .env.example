# Copy to .env and fill in. .env is gitignored and must never be committed.
# See docs/DATA_HANDLING.md

# --- Database (Phase 2) -----------------------------------------------------
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Model providers (Phase 3) ---------------------------------------------
MODEL_PROVIDER_API_KEY=

# --- Taste source (Phase 1a) -----------------------------------------------
# Used ONLY by the local snapshot producer in tools/private/.
# Application code never reads these. Never commit real values. See ADR 001.
TASTE_SOURCE_API_BASE=
TASTE_SOURCE_USER_ID=

# --- Local paths ------------------------------------------------------------
LOCAL_DATA_DIR=./data/local

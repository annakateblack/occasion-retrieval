# ---------------------------------------------------------------------------
# PRIVATE DATA — never commit
# See docs/DATA_HANDLING.md for the full policy and the reasoning behind it.
# ---------------------------------------------------------------------------

# Secrets and connection strings
.env
.env.*
!.env.example

# Personal data snapshots: save-app saves, Instagram export, downloaded images.
# Everything under data/local is personal. Nothing here is ever committed.
data/local/*
!data/local/.gitkeep

# Private engineering notes: source endpoint details, vendor specifics,
# anything not yet cleared for publication.
docs/private/*
!docs/private/.gitkeep

# Private tooling: snapshot producers that touch a live account.
tools/private/*
!tools/private/.gitkeep

# Raw Instagram export in any form
**/instagram_export/
**/saved_posts.json
**/saved_collections.json

# Instagram export inputs and derived output (added in the ingestion step)
data/local/instagram/*
!data/local/instagram/.gitkeep
data/local/derived/*
!data/local/derived/.gitkeep
**/ig_*_report.txt
**/ig_*.jsonl
**/ranking_*.json
**/ranking_*.txt

# Defense in depth: real model caches and relevance labels remain private even
# if a provider is accidentally configured outside data/local/.
**/enrichment_cache/
**/vlm_cache/
**/image_enrichment_cache/
**/relevance_labels*.json

# Real fit profile is personal data; only config/profile.example.json is committed
data/local/profile.json
profile.json
!config/profile.example.json

# Taste snapshots in any form
**/taste_snapshot*.json
**/taste_snapshot*.jsonl

# Any downloaded media
**/images/
*.jpg
*.jpeg
*.png
*.webp
!docs/assets/*.png

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# ---------------------------------------------------------------------------
# Node / frontend (Phase 8)
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
.vercel/

# ---------------------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
notebooks/**/*.ipynb

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

data/local/eval/
data/local/seed_images/
data/local/enriched/
data/local/enrichment_cache/
